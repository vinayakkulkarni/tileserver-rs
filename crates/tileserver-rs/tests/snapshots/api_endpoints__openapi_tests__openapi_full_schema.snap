                  "$ref": "#/components/schemas/TileJSON"
                }
              }
            }
          },
          "404": {
            "description": "Style not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
