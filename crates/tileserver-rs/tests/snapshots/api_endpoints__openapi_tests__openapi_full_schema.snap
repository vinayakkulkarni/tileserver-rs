            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "client_id": "client-abc-123",
          "client_name": "Claude.ai",
